    except Exception as draft_err:
        # Groq structured output sometimes rejects valid JSON via function-call validation.
        # The ``failed_generation`` field contains the raw output — parse it directly.
        draft_text = None
        source_citations = []
        grounding_score = 0.5
        missing_info_list = []
        err_str = str(draft_err)
        logger.warning(
            "[%s] draft_node structured output rejected; attempting recovery", workflow_id
        )
        if "failed_generation" in err_str:
            try:
                import json
                import re

                # Locate the JSON between <function=DraftOutput> and </function>
                fn_start = err_str.find("<function=DraftOutput>")
                if fn_start == -1:
                    fn_start = err_str.find("<function=DraftOutput")
                fn_end = err_str.rfind("</function>")
                if fn_start >= 0 and fn_end > fn_start:
                    # Extract just the JSON portion after the tag
                    json_start = err_str.find(">", fn_start) + 1
                    raw_json = err_str[json_start:fn_end].strip()

                    # Unescape common Python string escapes that Groq returns
                    raw_json = raw_json.replace("\\n", "\n").replace('\\"', '"').replace("\\\\", "\\")

                    # Try parsing; if it fails, try bracket-by-bracket extraction
                    try:
                        parsed = json.loads(raw_json)
                    except json.JSONDecodeError:
                        # Malformed JSON (e.g. unescaped quotes in text) —
                        # extract fields individually using simple string markers
                        parsed = {}
                        for field in ("draft_text",):
                            field_key = f'"{field}": "'
                            idx = raw_json.find(field_key)
                            if idx >= 0:
                                val_start = idx + len(field_key)
                                # Find end: the next unescaped ", then whitespace/comma
                                val_end = raw_json.find('",', val_start)
                                if val_end < 0:
                                    val_end = raw_json.find('"}', val_start)
                                if val_end >= 0:
                                    parsed[field] = raw_json[val_start:val_end]

                    draft_text = parsed.get("draft_text", "")
                    if isinstance(parsed.get("source_citations"), list):
                        source_citations = parsed["source_citations"]
                    grounding_score = float(parsed.get("grounding_score", 0.5))
                    if isinstance(parsed.get("missing_info"), list):
                        missing_info_list = parsed["missing_info"]
                    logger.info(
                        "[%s] draft_node recovered from failed_generation (grounding=%.2f)",
                        workflow_id, grounding_score,
                    )
            except Exception as parse_err:
                logger.error(
                    "[%s] draft_node recovery parse failed: %s", workflow_id, parse_err
                )

        if draft_text is None:
            return {
                "status": WorkflowStatus.FAILED.value,
                "error_context": f"Draft generation failed: {draft_err}",
            }
