GROQ_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# Postgres (Supabase)
DATABASE_URL=
DATABASE_URL_SYNC=
DB_AUTO_CREATE_ALL=false
DB_RUN_MIGRATIONS=false

# Redis (Local - much faster/reliable for dev)
# REDIS_URL="redis://localhost:6379/0"

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUD="authenticated"

# Redis (Upstash) — note: rediss:// (double s) for TLS
UPSTASH_HOST=
UPSTASH_PASSWORD=
UPSTASH_PORT=
REDIS_DISABLE_TLS_VERIFY=false

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=

COHERE_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Primary Embedder
VOYAGE_API_KEY=

# Gemini (Google AI)
# Used for OCR/vision extraction or LLM routing if configured in code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MODAL_ENDPOINT=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_BUCKET_NAME=

# Default local RabbitMQ (From docker-compose)
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672//"

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Security & CORS
CRON_SECRET=
CORS_ALLOWED_ORIGINS=https://legalrag.codes,https://www.legalrag.codes

# Frontend URL — REQUIRED in production. Used for password reset redirect links
# and Supabase invite email links. Must NOT be localhost in production.
# Example: https://your-app.yourdomain.com
FRONTEND_URL=
